rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mgbemere3@gmail.com'
      );
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'balance', 'kycStatus']) &&
             data.email is string &&
             data.balance is number &&
             data.kycStatus in ['Pending', 'Verified', 'Rejected', 'Not Set'] &&
             (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp) &&
             (!data.keys().hasAll(['firstName']) || (data.firstName is string && data.firstName.size() <= 100)) &&
             (!data.keys().hasAll(['lastName']) || (data.lastName is string && data.lastName.size() <= 100)) &&
             (!data.keys().hasAll(['country']) || (data.country is string && data.country.size() <= 100)) &&
             (!data.keys().hasAll(['phoneNumber']) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!data.keys().hasAll(['gender']) || (data.gender is string && data.gender.size() <= 50)) &&
             (!data.keys().hasAll(['dateOfBirth']) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 20)) &&
             (!data.keys().hasAll(['identityInfo']) || (data.identityInfo is map)) &&
             (!data.keys().hasAll(['totalProfit']) || data.totalProfit is number) &&
             (!data.keys().hasAll(['netProfit']) || data.netProfit is number) &&
             (!data.keys().hasAll(['netPortfolioValue']) || data.netPortfolioValue is number);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'status', 'date']) &&
             data.userId is string &&
             data.type is string &&
             data.amount is number &&
             data.status in ['Pending', 'Completed', 'Rejected'] &&
             data.date is timestamp &&
             (!data.keys().hasAll(['method']) || (data.method is string)) &&
             (!data.keys().hasAll(['tier']) || (data.tier is string && data.tier.size() <= 100)) &&
             (!data.keys().hasAll(['reference']) || (data.reference is string && data.reference.size() <= 60)) &&
             (!data.keys().hasAll(['asset']) || (data.asset is string)) &&
             (!data.keys().hasAll(['ticker']) || (data.ticker is string));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'name', 'price', 'status', 'orderDate', 'image', 'stats']) &&
             data.userId is string &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && 
             data.status is string && data.status.size() <= 50 &&
             data.orderDate is timestamp &&
             data.image is string &&
             data.stats is map &&
             (!data.keys().hasAll(['deliveryAddress']) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 500)) &&
             (!data.keys().hasAll(['additionalNotes']) || (data.additionalNotes is string && data.additionalNotes.size() <= 1000));
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if ((isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'kycStatus', 'identityInfo', 'firstName', 'lastName', 'country', 'phoneNumber', 'gender', 'dateOfBirth'])) || isAdmin()) && 
                    isValidId(userId) && isValidUser(incoming()) && 
                    (isAdmin() || (incoming().createdAt == existing().createdAt && incoming().email == existing().email));
    }

    match /transactions/{transactionId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() && isValidId(transactionId);
      allow delete: if isAdmin();
      allow create: if isSignedIn() && (isOwner(incoming().userId) || isAdmin()) && isValidId(transactionId) && isValidTransaction(incoming()) && (incoming().date == request.time || isAdmin());
      allow update: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().userId == existing().userId;
    }

    match /orders/{orderId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() && isValidId(orderId);
      allow delete: if isAdmin();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().orderDate == request.time;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin() && isValidId(adminId);
    }
  }
}
